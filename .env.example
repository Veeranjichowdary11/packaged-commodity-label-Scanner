APP_NAME="Packaged Commodity Label Scanner"
VERSION="1.0.0"
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./janch.db

# Authentication Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage Directories
UPLOAD_DIR=uploads
REPORTS_DIR=reports
MAX_UPLOAD_SIZE=10485760

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Vision OCR Service (Optional Google Cloud Vision API Key)
GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here
